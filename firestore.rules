rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserFarmId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmId;
    }

    function belongsToUserFarm(farmId) {
      return isAuthenticated() && farmId == getUserFarmId();
    }

    // ─── Nutrients (shared, read-only) ──────────────────────────────────
    // Master nutrient list is shared across all farms.
    // Only writable via Admin SDK / Firebase console.
    match /nutrients/{nutrientId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Animal Groups (shared, read-only) ──────────────────────────────
    // Pre-defined animal groups with target ranges.
    match /animalGroups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /targets/{targetId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ─── Feeds (per-farm) ───────────────────────────────────────────────
    match /feeds/{feedId} {
      allow read: if isAuthenticated()
        && resource.data.farmId == getUserFarmId();
      allow create: if isAuthenticated()
        && request.resource.data.farmId == getUserFarmId();
      allow delete: if isAuthenticated()
        && resource.data.farmId == getUserFarmId();
      // farmId is immutable: an update may never move a feed to another farm.
      allow update: if isAuthenticated()
        && resource.data.farmId == getUserFarmId()
        && request.resource.data.farmId == resource.data.farmId;
    }

    // ─── Recipes (per-farm) ─────────────────────────────────────────────
    match /recipes/{recipeId} {
      allow read: if isAuthenticated()
        && resource.data.farmId == getUserFarmId();
      allow create: if isAuthenticated()
        && request.resource.data.farmId == getUserFarmId();
      allow delete: if isAuthenticated()
        && resource.data.farmId == getUserFarmId();
      // farmId is immutable: an update may never move a recipe to another farm.
      allow update: if isAuthenticated()
        && resource.data.farmId == getUserFarmId()
        && request.resource.data.farmId == resource.data.farmId;

      // Recipe feed entries subcollection
      match /feeds/{feedEntryId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/recipes/$(recipeId)).data.farmId == getUserFarmId();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/recipes/$(recipeId)).data.farmId == getUserFarmId();
      }
    }

    // ─── User Profiles ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // farmId may only be set to a farm the caller actually owns, so a
      // profile write can never grant access to someone else's farm data.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && get(/databases/$(database)/documents/farms/$(request.resource.data.farmId)).data.ownerUid == request.auth.uid;
      // farmId is immutable after creation — only non-farm profile fields
      // (displayName, language, ...) may be updated.
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.farmId == resource.data.farmId;
      allow delete: if false;
    }

    // ─── Farms ──────────────────────────────────────────────────────────
    match /farms/{farmId} {
      allow read: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      // ownerUid is immutable: a farm can never be handed to another account
      // through a client write.
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
  }
}
