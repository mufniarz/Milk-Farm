rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Deterministic membership id: {farmId}_{uid}. A single document lookup
    // keeps the rules simple and lets one user belong to several farms.
    function isMember(farmId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/farmMembers/$(farmId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/farmMembers/$(farmId + '_' + request.auth.uid)).data.status == 'active';
    }

    function hasRole(farmId, roles) {
      return isMember(farmId)
        && get(/databases/$(database)/documents/farmMembers/$(farmId + '_' + request.auth.uid)).data.role in roles;
    }

    // ─── System health (heartbeat; server-written, authenticated read) ──
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Nutrients (shared, read-only) ──────────────────────────────────
    match /nutrients/{nutrientId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Animal Groups (shared, read-only) ──────────────────────────────
    match /animalGroups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /targets/{targetId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ─── Farm Memberships ───────────────────────────────────────────────
    // Reads: the member themselves, or a farm admin listing the farm's team.
    // Writes: the owner may create their own owner membership when they
    // create the farm; every other grant/revoke goes through a callable.
    match /farmMembers/{memberId} {
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid
            || hasRole(resource.data.farmId, ['owner', 'farmAdmin']));

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && memberId == request.resource.data.farmId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/farms/$(request.resource.data.farmId)).data.ownerUid == request.auth.uid;

      allow update, delete: if false;
    }

    // ─── Farms ──────────────────────────────────────────────────────────
    match /farms/{farmId} {
      allow read: if isAuthenticated()
        && (resource.data.ownerUid == request.auth.uid
            || isMember(farmId));
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.ownerUid == request.auth.uid
            || hasRole(farmId, ['owner', 'farmAdmin']))
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      // ── Target overrides (callable-written, member-readable) ──
      // The document id is the nutritional category (lactating/dry/heifer),
      // not the herd group id.
      match /targetOverrides/{animalGroupId} {
        allow read: if isMember(farmId);
        allow write: if false;
      }

      // ── Audit log (Admin SDK / callable writes only) ──
      match /auditLog/{entryId} {
        allow read: if hasRole(farmId, ['owner', 'farmAdmin']);
        allow write: if false;
      }

      // ── Herd groups (subcollection: the path scopes the farm) ──
      match /groups/{groupId} {
        allow read: if isMember(farmId);
        allow create, update, delete: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        );
      }

      // ── Feeders (names, not logins) ──
      match /feeders/{feederId} {
        allow read: if isMember(farmId);
        allow create, update: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        )
          && request.resource.data.farmId == farmId;
        allow delete: if hasRole(farmId, ['owner', 'farmAdmin']);
      }

      // ── Feedings (draft by the barn, confirmed once) ──
      // A feeding is created as a draft and may be edited only while the
      // stored status is draft. Confirmation is one client update; after it
      // the document is immutable from the client and the inventory trigger
      // writes inventoryPostedAt with the Admin SDK.
      match /feedings/{feedingId} {
        // Feeders are names on the feeding, not logins: the loading sheet is
        // operated by the owner, farm admin or consultant. A feeder-role
        // account cannot read or write feedings; if feeder logins are added
        // later, introduce an explicit feederUid and scope on it.
        allow read: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        );
        allow create: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        )
          && request.resource.data.farmId == farmId
          && request.resource.data.status == 'draft';
        allow update: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        )
          && resource.data.status == 'draft'
          && request.resource.data.farmId == resource.data.farmId
          && request.resource.data.status in ['draft', 'confirmed'];
        allow delete: if hasRole(farmId, ['owner', 'farmAdmin'])
          && resource.data.status == 'draft';
      }

      // ── Milk records (economics: owner/admin/consultant only) ──
      match /milkRecords/{recordId} {
        allow read: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        );
        allow create, update: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        )
          && request.resource.data.farmId == farmId;
        allow delete: if hasRole(farmId, ['owner', 'farmAdmin']);
      }

      // ── Trigger failure queue (server-written, operator-readable) ──
      match /feedingTriggerFailures/{failureId} {
        allow read: if hasRole(
          farmId,
          ['owner', 'farmAdmin', 'consultant']
        );
        allow write: if false;
      }

      // ── Inventory (callable-written, member-readable) ──
      match /inventoryItems/{itemId} {
        allow read: if isMember(farmId);
        allow write: if false;
      }
      match /inventoryTransactions/{txId} {
        allow read: if isMember(farmId);
        allow write: if false;
      }
    }

    // ─── Feeds (per-farm) ───────────────────────────────────────────────
    match /feeds/{feedId} {
      allow read: if isAuthenticated()
        && isMember(resource.data.farmId);
      allow create: if isAuthenticated()
        && isMember(request.resource.data.farmId);
      allow delete: if isAuthenticated()
        && isMember(resource.data.farmId);
      // farmId is immutable: an update may never move a feed to another farm.
      allow update: if isAuthenticated()
        && isMember(resource.data.farmId)
        && request.resource.data.farmId == resource.data.farmId;
    }

    // ─── Recipes (per-farm) ─────────────────────────────────────────────
    match /recipes/{recipeId} {
      allow read: if isAuthenticated()
        && isMember(resource.data.farmId);
      allow create: if isAuthenticated()
        && isMember(request.resource.data.farmId);
      allow delete: if isAuthenticated()
        && isMember(resource.data.farmId);
      allow update: if isAuthenticated()
        && isMember(resource.data.farmId)
        && request.resource.data.farmId == resource.data.farmId;

      match /feeds/{feedEntryId} {
        allow read: if isAuthenticated()
          && isMember(get(/databases/$(database)/documents/recipes/$(recipeId)).data.farmId);
        allow write: if isAuthenticated()
          && isMember(get(/databases/$(database)/documents/recipes/$(recipeId)).data.farmId);
      }
    }

    // ─── User Profiles ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId
        && get(/databases/$(database)/documents/farms/$(request.resource.data.farmId)).data.ownerUid == request.auth.uid;
      // farmId is immutable after creation — only non-farm profile fields
      // (displayName, language, ...) may be updated.
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.farmId == resource.data.farmId;
      allow delete: if false;
    }
  }
}
